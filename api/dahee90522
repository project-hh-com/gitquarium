<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 850 180" width="100%" height="100%" shape-rendering="crispEdges">
  <defs>
    <pattern id="pixelGrid" width="8" height="8" patternUnits="userSpaceOnUse">
      <rect width="8" height="8" fill="#0b1021" />
      <rect x="0" y="0" width="4" height="4" fill="#0f172a" opacity="0.4" />
      <rect x="4" y="4" width="4" height="4" fill="#0f172a" opacity="0.4" />
    </pattern>
  </defs>

  <style>
  <![CDATA[
    @keyframes pixelSway1 {
      0% { transform: translate(0, 0); }
      50% { transform: translate(-6px, 0); }
      100% { transform: translate(6px, 0); }
    }
    @keyframes pixelSway2 {
      0% { transform: translate(0, 0); }
      50% { transform: translate(5px, 0); }
      100% { transform: translate(-5px, 0); }
    }
    @keyframes pixelBubble {
      0% { transform: translateY(0); opacity: 0; }
      20% { opacity: 0.9; }
      80% { opacity: 0.7; }
      100% { transform: translateY(-145px); opacity: 0; }
    }
    /* 🪼 TS Jellyfish Roaming and Propulsion Animation */
    @keyframes pixelJellyRoam {
      0%   { transform: translate(380px, 79px); }
      25%  { transform: translate(410px, 59px); }
      50%  { transform: translate(465px, 71px); }
      75%  { transform: translate(435px, 93px); }
      100% { transform: translate(380px, 79px); }
    }
    .jelly-roam { animation: pixelJellyRoam 8s steps(60) infinite ease-in-out; }
    .pb1 { animation: pixelBubble 4s steps(15) infinite; }
    .pb2 { animation: pixelBubble 5.2s steps(15) infinite 1.2s; }
    .pb3 { animation: pixelBubble 4.6s steps(15) infinite 2.5s; }
    .sway-left { animation: pixelSway1 3.5s steps(6) infinite alternate; }
    .sway-right { animation: pixelSway2 4s steps(6) infinite alternate; }

    @keyframes pufferTrack {
      0%   { transform: translate(60px, 62px) scale(1, 1); }
      49%  { transform: translate(740px, 54px) scale(1, 1); }
      50%  { transform: translate(740px, 54px) scale(-1, 1); }
      99%  { transform: translate(60px, 68px) scale(-1, 1); }
      100% { transform: translate(60px, 62px) scale(1, 1); }
    }
    .creature-puffer { animation: pufferTrack 21s steps(60) infinite 1s; }
    @keyframes rayTrack {
      0%   { transform: translate(730px, 93px) scale(-1, 1); }
      49%  { transform: translate(70px, 86px) scale(-1, 1); }
      50%  { transform: translate(70px, 86px) scale(1, 1); }
      99%  { transform: translate(730px, 100px) scale(1, 1); }
      100% { transform: translate(730px, 93px) scale(-1, 1); }
    }
    .creature-ray { animation: rayTrack 18s steps(60) infinite 3s; }
    @keyframes anglerTrack {
      0%   { transform: translate(80px, 122px) scale(1, 1); }
      49%  { transform: translate(720px, 129px) scale(1, 1); }
      50%  { transform: translate(720px, 129px) scale(-1, 1); }
      99%  { transform: translate(80px, 117px) scale(-1, 1); }
      100% { transform: translate(80px, 122px) scale(1, 1); }
    }
    .creature-angler { animation: anglerTrack 24s steps(60) infinite 5s; }
    @keyframes tetraTrack1 {
      0%   { transform: translate(50px, 50px) scale(1, 1); }
      49%  { transform: translate(740px, 46px) scale(1, 1); }
      50%  { transform: translate(740px, 46px) scale(-1, 1); }
      99%  { transform: translate(50px, 54px) scale(-1, 1); }
      100% { transform: translate(50px, 50px) scale(1, 1); }
    }
    .tetra-1 { animation: tetraTrack1 13s steps(50) infinite 0.0s; }
    @keyframes tetraTrack2 {
      0%   { transform: translate(740px, 108px) scale(-1, 1); }
      49%  { transform: translate(60px, 112px) scale(-1, 1); }
      50%  { transform: translate(60px, 112px) scale(1, 1); }
      99%  { transform: translate(740px, 104px) scale(1, 1); }
      100% { transform: translate(740px, 108px) scale(-1, 1); }
    }
    .tetra-2 { animation: tetraTrack2 16s steps(50) infinite 4.0s; }
    @keyframes tetraTrack3 {
      0%   { transform: translate(50px, 75px) scale(1, 1); }
      49%  { transform: translate(740px, 71px) scale(1, 1); }
      50%  { transform: translate(740px, 71px) scale(-1, 1); }
      99%  { transform: translate(50px, 79px) scale(-1, 1); }
      100% { transform: translate(50px, 75px) scale(1, 1); }
    }
    .tetra-3 { animation: tetraTrack3 15s steps(50) infinite 6.5s; }
    @keyframes tetraTrack4 {
      0%   { transform: translate(740px, 135px) scale(-1, 1); }
      49%  { transform: translate(60px, 139px) scale(-1, 1); }
      50%  { transform: translate(60px, 139px) scale(1, 1); }
      99%  { transform: translate(740px, 131px) scale(1, 1); }
      100% { transform: translate(740px, 135px) scale(-1, 1); }
    }
    .tetra-4 { animation: tetraTrack4 19s steps(50) infinite 2.5s; }
  ]]>
  </style>

